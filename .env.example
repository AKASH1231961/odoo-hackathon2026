# DATABASE_URL and REDIS_URL below are for running outside Docker;
# docker-compose.yml sets its own for the containers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/subscription_db
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=postgres
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-use-64-char-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Mailpit from docker-compose catches all mail: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=billing@brightloop.test
# To send real email through Gmail, replace the five SMTP lines above with:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=sixteen-letter-app-password-with-no-spaces
# SMTP_FROM=your.address@gmail.com
UI_PORT=8081
# Password reset emails link here
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081
ENVIRONMENT=development
SEED_DEMO_DATA=true
# First admin, when no admin exists and demo data is off
ADMIN_EMAIL=
ADMIN_PASSWORD=
